---
layout: layouts/base.njk
pagination:
  data: zoznamRocnikov
  size: 1
  alias: r
permalink: "/rocniky/{{ r.cislo }}/"
eleventyComputed:
  title: "{{ r.nazov }}"
---
{% set lekcie = collections.lekcie | preRocnik(r.cislo) %}
<nav class="omrvinky" aria-label="Kde sa nachádzaš"><a href="/">Domov</a> <span aria-hidden="true">/</span> <a href="/rocniky/">Podľa ročníka</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ r.nazov }}</span></nav>
<header class="stranka-hlava">
  <h1 class="stranka-hlava__nadpis">{{ r.nazov }}</h1>
  <p>Preberáme: {% for z in r.rozsah %}<a href="/ucebnice/{{ z.id }}/">{{ z | rozsahText }}</a>{% if not loop.last %}, potom {% endif %}{% endfor %}</p>
</header>
{% if lekcie.length %}
{% for s in lekcie | podlaUnitov(r) %}
<section class="sekcia rocnik-unit"{% if s.nadpis %} aria-labelledby="h-{{ s.id }}"{% endif %}>
  {% if s.nadpis %}
  <h2 id="h-{{ s.id }}" class="sekcia__nadpis sekcia__nadpis--male">{{ s.nadpis }}</h2>
  {# názov unitu: pri jednej lekcii vedie rovno na lekciu (nie na stránku učebnice), pri viacerých je len text – lekcie sú v kartách pod ním #}
  {% if s.tema %}<p class="rocnik-unit__tema">{% if s.lekcie.length == 1 %}<a href="{{ s.lekcie[0].url }}">{{ s.tema }}</a>{% else %}{{ s.tema }}{% endif %}</p>{% endif %}
  {% endif %}
  <div class="mriezka">
    {% for l in s.lekcie %}{% include "partials/karta.njk" %}{% endfor %}
  </div>
  {% if s.kniha and (collections.lekcie | pocetPredPisomkou(s.kniha, s.unit)) %}
  <p class="rocnik-unit__pp"><a class="pred-pisomkou" href="/pred-pisomkou/#{{ s.kniha }}/{{ s.unit }}"><span class="pred-pisomkou__znak" aria-hidden="true">✓</span><span><b>Pred písomkou</b><br>{{ collections.lekcie | pocetPredPisomkou(s.kniha, s.unit) }} náhodných otázok z gramatiky · {{ s.nadpis }}</span></a></p>
  {% endif %}
  {% set opak = (collections.lekcie | opakovaniePo(s.kniha, s.unit)) if s.kniha else null %}
  {% if opak %}
  <p class="rocnik-unit__pp"><a class="pred-pisomkou pred-pisomkou--velke" href="/pred-pisomkou/#{{ s.kniha }}/{{ opak.id }}"><span class="pred-pisomkou__znak" aria-hidden="true">★</span><span><b>Veľké opakovanie: Units {{ opak.id | replace("-", "–") }}</b><br>{{ opak.pocet }} otázok z troch unitov pred veľkou písomkou</span></a></p>
  {% endif %}
</section>
{% endfor %}
{% else %}
<div class="prazdne">
  <img src="/assets/img/postavy/koza-nechape.png" alt="" width="140">
  <p>Pre {{ r.nazov }} tu zatiaľ nie sú žiadne lekcie. Čoskoro pribudnú!</p>
  <p><a href="/kontakt/">Navrhni tému, ktorú by si chcel vysvetliť.</a></p>
</div>
{% endif %}
