---
layout: layouts/base.njk
bodyClass: stranka-pravidlo
skripty: ["lekcia.js"]
---
{% set vsetky = collections.pravidla %}
<nav class="omrvinky" aria-label="Kde sa nachádzaš">
  <a href="/">Domov</a> <span aria-hidden="true">/</span>
  <a href="/pravidla/">Zlaté pravidlá</a> <span aria-hidden="true">/</span>
  <span aria-current="page">Pravidlo {{ cislo }}</span>
</nav>

<header class="pravidlo-hlava" data-lekcia="pravidlo-{{ cislo }}">
  <span class="pravidlo-hlava__cislo" aria-hidden="true">{{ cislo }}</span>
  <div>
    <p class="nadnadpis">Zlaté pravidlo č. {{ cislo }}</p>
    <h1 class="pravidlo-hlava__nadpis">{{ title }}</h1>
    <p class="pravidlo-hlava__popis">{{ popis }}</p>
    {% if priklad %}<p class="pravidlo-hlava__priklad" lang="en">{{ priklad }}</p>{% endif %}
  </div>
</header>

<div class="lekcia-media">
  <section class="blok blok--video" aria-labelledby="h-video">
    <h2 id="h-video" class="blok__nadpis"><span class="blok__pismeno">A</span> Video</h2>
    {% if video %}
      <video class="video" controls preload="metadata" playsinline {% if poster %}poster="{{ page.url }}{{ poster }}"{% endif %}>
        <source src="{{ page.url }}{{ video }}" type="video/mp4">
        Tvoj prehliadač nevie prehrať video. <a href="{{ page.url }}{{ video }}">Stiahni si ho.</a>
      </video>
    {% else %}
      <div class="video video--chyba">
        <img src="/assets/img/postavy/koza-premysla.png" alt="" width="120">
        <p>Video sa ešte chystá.<br>Zatiaľ si prečítaj vysvetlenie nižšie.</p>
      </div>
    {% endif %}
  </section>

  <section class="blok blok--infografika" aria-labelledby="h-info">
    <h2 id="h-info" class="blok__nadpis"><span class="blok__pismeno">B</span> Infografika</h2>
    {% if infografika %}
      <button type="button" class="infografika" data-zvacsi aria-label="Zväčšiť infografiku">
        <img src="{{ page.url }}{{ infografika }}" alt="Infografika: {{ title }}" loading="lazy">
        <span class="infografika__lupa"><svg width="18" height="18"><use href="#lupa"/></svg> Zväčšiť</span>
      </button>
      <p class="stiahni">
        <a class="tlacidlo tlacidlo--tiche" href="{{ page.url }}{{ infografika }}" download>Stiahnuť obrázok</a>
        {% if infografikaPdf %}<a class="tlacidlo tlacidlo--tiche" href="{{ page.url }}{{ infografikaPdf }}" download>Stiahnuť na tlač (PDF)</a>{% endif %}
      </p>
      <dialog class="zvacsenie" aria-label="Infografika vo veľkom">
        <form method="dialog"><button class="zvacsenie__zavri" aria-label="Zavrieť">✕</button></form>
        <img src="{{ page.url }}{{ infografika }}" alt="Infografika: {{ title }}">
      </dialog>
    {% else %}
      <div class="infografika infografika--chyba"><p>Infografika sa ešte kreslí.</p></div>
    {% endif %}
  </section>
</div>

<section class="blok blok--vyklad" aria-labelledby="h-vyklad">
  <h2 id="h-vyklad" class="blok__nadpis"><span class="blok__pismeno">C</span> Vysvetlenie</h2>
  <div class="zosit">
    {{ content | safe }}
  </div>
</section>

{% if lekcie and lekcie.length %}
<section class="sekcia">
  <h2 class="sekcia__nadpis sekcia__nadpis--male">Kde to uvidíš</h2>
  <div class="mriezka">
    {% for l in collections.lekcie %}{% if lekcie.includes(l.fileSlug) %}{% include "partials/karta.njk" %}{% endif %}{% endfor %}
  </div>
</section>
{% endif %}

<nav class="pravidlo-dalej" aria-label="Ďalšie pravidlá">
  {% for p in vsetky %}{% if p.data.cislo == cislo - 1 %}<a class="tlacidlo tlacidlo--tiche" href="{{ p.url }}">← Pravidlo {{ p.data.cislo }}</a>{% endif %}{% endfor %}
  <a class="tlacidlo tlacidlo--tiche" href="/pravidla/">Všetkých 10 pravidiel</a>
  {% for p in vsetky %}{% if p.data.cislo == cislo + 1 %}<a class="tlacidlo tlacidlo--tiche" href="{{ p.url }}">Pravidlo {{ p.data.cislo }} →</a>{% endif %}{% endfor %}
</nav>
