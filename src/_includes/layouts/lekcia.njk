---
layout: layouts/base.njk
bodyClass: stranka-lekcia
skripty: ["lekcia.js"]
---
{% set hlavnaTema = (temy[0] | tema) if temy and temy.length else null %}
<nav class="omrvinky" aria-label="Kde sa nachádzaš">
  <a href="/">Domov</a>
  {% if hlavnaTema %}<span aria-hidden="true">/</span> <a href="/temy/{{ hlavnaTema.id }}/">{{ hlavnaTema.nazov }}</a>{% endif %}
  <span aria-hidden="true">/</span> <span aria-current="page">{{ title }}</span>
</nav>

<header class="lekcia-hlava" data-lekcia="{{ page.fileSlug }}">
  <div class="lekcia-hlava__text">
    <p class="nadnadpis">Grammar Bite</p>
    <h1 class="lekcia-hlava__nadpis">{{ title }}</h1>
    {% if nazovSk %}<p class="lekcia-hlava__sk">{{ nazovSk }}</p>{% endif %}
    <p class="lekcia-hlava__popis">{{ popis }}</p>
    <ul class="stitky">
      {% for r in rocniky %}<li><a class="stitok stitok--rocnik" href="/rocniky/{{ r }}/">{{ r }}. ročník</a></li>{% endfor %}
      {% for u in ucebnice %}<li><a class="stitok" href="/ucebnice/{{ u.id }}/{% if u.unit %}#unit-{{ u.unit }}{% endif %}">{{ u | unitNazov }}</a></li>{% endfor %}
      {% for t in temy %}<li><a class="stitok stitok--tema" href="/temy/{{ t }}/">{{ (t | tema).nazov }}</a></li>{% endfor %}
    </ul>
  </div>
  <figure class="lekcia-hlava__koza" aria-hidden="true">
    <span class="bublina">{{ otazkaKozy or "Can you explain this?" }}</span>
    <img src="/assets/img/postavy/{{ koza or 'koza-zvedava' }}.png" alt="" width="180">
  </figure>
</header>

<div class="lekcia-media{% if videoFormat == 'na-sirku' %} lekcia-media--sirka{% endif %}">
  <section class="blok blok--video" aria-labelledby="h-video">
    <h2 id="h-video" class="blok__nadpis"><span class="blok__pismeno">A</span> Video</h2>
    {% if video %}
      <video class="video" controls preload="metadata" playsinline {% if poster or nahlad %}poster="{{ page.url }}{{ poster or nahlad }}"{% endif %}>
        <source src="{{ page.url }}{{ video }}" type="video/mp4">
        Tvoj prehliadač nevie prehrať video. <a href="{{ page.url }}{{ video }}">Stiahni si ho.</a>
      </video>
    {% elif youtube %}
      <div class="video video--yt">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ youtube }}?rel=0" title="{{ title }} – video" allow="encrypted-media; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
    {% else %}
      <div class="video video--chyba">
        <img src="/assets/img/postavy/koza-premysla.png" alt="" width="120">
        <p>Video sa ešte chystá.<br>Zatiaľ si pozri infografiku a výklad.</p>
      </div>
    {% endif %}
  </section>

  <section class="blok blok--infografika" aria-labelledby="h-info">
    <h2 id="h-info" class="blok__nadpis"><span class="blok__pismeno">B</span> Infografika</h2>
    {% if infografika %}
      <button type="button" class="infografika" data-zvacsi aria-label="Zväčšiť infografiku">
        <img src="{{ page.url }}{{ infografika }}" alt="Infografika: {{ title }}" loading="lazy">
        <span class="infografika__lupa"><svg width="18" height="18"><use href="#lupa"/></svg> Zväčšiť</span>
      </button>
      <p class="stiahni">
        <a class="tlacidlo tlacidlo--tiche" href="{{ page.url }}{{ infografika }}" download>Stiahnuť obrázok</a>
        {% if infografikaPdf %}<a class="tlacidlo tlacidlo--tiche" href="{{ page.url }}{{ infografikaPdf }}" download>Stiahnuť na tlač (PDF)</a>{% endif %}
      </p>
      <dialog class="zvacsenie" aria-label="Infografika vo veľkom">
        <form method="dialog"><button class="zvacsenie__zavri" aria-label="Zavrieť">✕</button></form>
        <img src="{{ page.url }}{{ infografika }}" alt="Infografika: {{ title }}">
      </dialog>
    {% else %}
      <div class="infografika infografika--chyba">
        <p>Infografika sa ešte kreslí.</p>
      </div>
    {% endif %}
  </section>
</div>

<section class="blok blok--vyklad" aria-labelledby="h-vyklad">
  <h2 id="h-vyklad" class="blok__nadpis"><span class="blok__pismeno">C</span> Výklad</h2>
  <div class="zosit">
    {{ content | safe }}
  </div>
</section>

{% set dalsiePismeno = "D" %}
{% if trener %}{% set pismeno = dalsiePismeno %}{% include "partials/trener.njk" %}{% set dalsiePismeno = "E" %}{% elif rodostrom %}{% set pismeno = dalsiePismeno %}{% include "partials/rodostrom.njk" %}{% set dalsiePismeno = "E" %}{% elif hodiny %}{% set pismeno = dalsiePismeno %}{% include "partials/hodiny.njk" %}{% set dalsiePismeno = "E" %}{% elif pasivum %}{% set pismeno = dalsiePismeno %}{% include "partials/pasivum.njk" %}{% set dalsiePismeno = "E" %}{% elif vztazne %}{% set pismeno = dalsiePismeno %}{% include "partials/vztazne.njk" %}{% set dalsiePismeno = "E" %}{% elif casovaOs %}{% set pismeno = dalsiePismeno %}{% include "partials/casovaos.njk" %}{% set dalsiePismeno = "E" %}{% elif kosik %}{% set pismeno = dalsiePismeno %}{% include "partials/kosik.njk" %}{% set dalsiePismeno = "E" %}{% elif izba %}{% set pismeno = dalsiePismeno %}{% include "partials/izba.njk" %}{% set dalsiePismeno = "E" %}{% elif porovnanie %}{% set pismeno = dalsiePismeno %}{% include "partials/porovnanie.njk" %}{% set dalsiePismeno = "E" %}{% endif %}
{% if pisanie %}{% set pismeno = dalsiePismeno %}{% include "partials/pisanie.njk" %}{% set dalsiePismeno = "F" if dalsiePismeno == "E" else "E" %}{% endif %}
{% if hraSlovesa %}{% set pismeno = dalsiePismeno %}{% include "partials/hra-slovesa.njk" %}{% set dalsiePismeno = {"D": "E", "E": "F", "F": "G"}[dalsiePismeno] %}{% endif %}

{% if test and test.length %}
<section class="blok blok--test" aria-labelledby="h-test">
  <h2 id="h-test" class="blok__nadpis"><span class="blok__pismeno">{{ dalsiePismeno }}</span> Mini test</h2>
  <p class="blok__uvod">{{ test.length }} {% if test.length >= 5 %}otázok{% else %}otázky{% endif %} na precvičenie. Nič sa neukladá ani nehodnotí – skúšaj, koľkokrát chceš.</p>
  <form class="test" data-test novalidate>
    {% for q in test %}
    {% set qi = loop.index %}
    <fieldset class="otazka" data-spravna="{{ q.spravna }}">
      <legend><span class="otazka__cislo">{{ qi }}</span> {{ q.otazka | safe }}</legend>
      <div class="moznosti">
        {% for m in q.moznosti %}
        <label class="moznost"><input type="radio" id="q{{ qi }}-{{ loop.index0 }}" name="q{{ qi }}" value="{{ loop.index0 }}"> <span>{{ m | safe }}</span></label>
        {% endfor %}
      </div>
      <p class="otazka__spatna" hidden data-ok="{{ q.vysvetlenie }}"></p>
    </fieldset>
    {% endfor %}
    <div class="test__ovladanie">
      <button type="submit" class="tlacidlo">Skontrolovať odpovede</button>
      <button type="button" class="tlacidlo tlacidlo--tiche" data-znova hidden>Skúsiť znova</button>
    </div>
    <div class="test__vysledok" role="status" aria-live="polite" hidden>
      <img src="/assets/img/postavy/koza-oslavuje.png" alt="" width="90" data-obr-dobre hidden>
      <img src="/assets/img/postavy/koza-nechape.png" alt="" width="90" data-obr-zle hidden>
      <p></p>
    </div>
  </form>
</section>
{% endif %}

<aside class="zdielaj">
  <p>Pošli lekciu spolužiakovi:</p>
  <div class="zdielaj__riadok">
    <input id="odkaz-lekcie" type="text" readonly value="" aria-label="Odkaz na lekciu">
    <button type="button" class="tlacidlo tlacidlo--tiche" data-kopiruj="odkaz-lekcie">Kopírovať odkaz</button>
  </div>
</aside>

{% set suvisiace = (collections.lekcie | preTemu(hlavnaTema.id) | bezStranky(page.url) | head(3)) if hlavnaTema else [] %}
{% if suvisiace.length %}
<section class="sekcia">
  <h2 class="sekcia__nadpis">Ďalšie lekcie: {{ hlavnaTema.nazov }}</h2>
  <div class="mriezka">
    {% for l in suvisiace %}{% include "partials/karta.njk" %}{% endfor %}
  </div>
</section>
{% endif %}
