---
layout: layouts/base.njk
title: Magická tabuľa
titleSk: Magická tabuľa
popis: "Napíš, čomu nerozumieš, a vysvetlím ti to na Magickej tabuli krok po kroku."
skripty: ["chat-motor.js", "tabula-chat.js", "tabula.js"]
---
<div class="tabula-app" data-tabula-app>
  <section class="tb-vyber" data-vyber aria-labelledby="h-tabula">
    <header class="tb-uvod">
      <div class="tb-ram">
        <div class="tb-doska tb-doska--uvod">
          <h1 id="h-tabula" class="tb-nadpis">Magická tabuľa</h1>
          <p class="tb-uvod__en tb-pise" lang="en">How can I help you?</p>
          <p class="tb-uvod__sk tb-pise">Ako ti môžem pomôcť?</p>
          <p class="tb-uvod__pozn">Napíš, čomu nerozumieš, alebo si vyber tému. Vysvetlím ti to krok po kroku – tempom, ktoré si určíš sám.</p>
        </div>
      </div>
      <img class="tb-uvod__ucitel" src="/assets/img/postavy/ucitel.png" alt="" width="110" height="184">
    </header>
    <div class="tc-log" data-chat aria-live="polite" aria-label="Rozhovor" hidden></div>
    <form class="hladanie tc-vstup" data-otazka-form autocomplete="off">
      <div class="hladanie__pole">
        <label for="tb-q" class="sr">Čomu nerozumieš?</label>
        <input id="tb-q" data-otazka-pole type="text" maxlength="160" enterkeyhint="send" placeholder="Napíš svoju otázku…">
        <button type="button" class="tlacidlo tlacidlo--tiche tlacidlo--male tc-apo" data-apostrof aria-label="Vložiť apostrof" title="Vložiť apostrof">'</button>
      </div>
      <button type="submit" class="tlacidlo">Opýtať sa</button>
    </form>
    <p class="tc-tip">Píš pokojne aj bez dĺžňov a s preklepmi. Môžeš napísať aj celú vetu, pri ktorej si nie si istý.</p>
    <div class="tb-ponuka">
      <p class="tb-ponuka__nadpis">Alebo si vyber tému – na tieto otázky už mám pripravenú tabuľu:</p>
      <div class="tb-skupiny" data-cipy></div>
    </div>
    <p class="tb-chyba">Niečo ti tu chýba? <a href="/kontakt/">Napíš mi</a> a ja to doplním.</p>
  </section>

  <section class="tb-obal" data-tabula hidden aria-labelledby="h-tabula-nadpis">
    <div class="tb-hore">
      <button type="button" class="tlacidlo tlacidlo--tiche tlacidlo--male" data-ina>← Iná otázka</button>
      <a class="tb-hore__lekcia" data-spat-lekcia href="/">Lekcia</a>
    </div>
    <div class="tb-ram" data-ram>
      <div class="tb-doska">
        <h2 id="h-tabula-nadpis" class="tb-nadpis" data-nadpis></h2>
        <div class="tb-plocha" data-plocha></div>
      </div>
    </div>
    <div class="tb-popis" data-popis aria-live="polite"></div>
    <div class="tb-ovladanie">
      <button type="button" class="tlacidlo tlacidlo--tiche" data-spat aria-label="Predchádzajúci krok">← Späť</button>
      <span class="tb-stav" data-stav></span>
      <button type="button" class="tlacidlo" data-dalej>Ďalej →</button>
      <button type="button" class="tlacidlo" data-znova hidden>Ešte raz od začiatku</button>
      <button type="button" class="tlacidlo tlacidlo--tiche tlacidlo--male tb-zvuk" data-zvuk hidden aria-pressed="true">🔊 Zvuk</button>
      <button type="button" class="tlacidlo tlacidlo--tiche tlacidlo--male tb-cela" data-cela>Na celú obrazovku</button>
    </div>
  </section>
</div>
<script type="application/json" id="data-tabule">{{ tabule | json | safe }}</script>
<script type="application/json" id="data-lekcie-chat">{{ collections.lekcie | indexChatu | json | safe }}</script>
<script type="application/json" id="data-slovnik">{{ slovnik.skupiny | json | safe }}</script>
